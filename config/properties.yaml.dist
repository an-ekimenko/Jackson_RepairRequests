toir-api:
  # Base URL for fetching passportization data
  data_endpoint: https://your-api-domain/api/v1/data
  
  # Authentication strategy: none | basic | token | oauth2
  auth_type: basic

  auth:
    # Used only if auth_type: basic
    basic:
      username: YOUR_ACN_SERVICE_USERNAME
      password: YOUR_ACN_SERVICE_PASSWORD

    # Used only if auth_type: token (pre-generated static Bearer/API key)
    static_token: YOUR_STATIC_TOKEN

    # Used only if auth_type: oauth2 (Client Credentials Grant workflow)
    oauth2:
      token_endpoint: https://your-corporate-gateway-domain/identity/connect/token
      client_id: YOUR_CLIENT_ID
      client_secret: YOUR_CLIENT_SECRET
      scope: YOUR_SCOPE
      grant_type: client_credentials

  # Target gas station equipment SUID suffixes to filter incoming repair requests
  equipment_classifier_codes:
    - "_CF"    # Coffee machines
    - "_PPS"   # Tire inflation stations
    - "_VC"    # Vacuum cleaners

  # Connection settings (in milliseconds)
  connection:
    connect_timeout_ms: 50000
    response_timeout_ms: 120000

